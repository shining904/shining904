[[1.03, 2.69, "안녕하십니까."],
 [3.00, 4.13, "이천시장 성수석입니다."],
 [5.80, 8.07, "대한민국의 바다를 지키는 잠수함,"],
 [8.80, 12.95, "서희함의 진수를 이천시민과 함께/진심으로 축하드립니다."],
 [13.95, 18.42, "서희 선생님은 나라를 지킨/고려의 외교가이자"],
 [18.73, 22.33, "우리 이천의 정신과/역사의 뿌리입니다."],
 [22.97, 26.86, "이제 그 이름이/바닷속에서 조용히,"],
 [27.25, 29.94, "그리고 든든하게/대한민국을 지키게 되었습니다."],
 [30.62, 33.16, "서희함을 위해/애써 주신 모든 분들과"],
 [33.49, 35.56, "해군 장병 여러분께/감사드리며,"],
 [36.11, 38.63, "서희함의 힘찬 항해를/응원합니다."],
 [39.24, 39.84, "감사합니다."]]
